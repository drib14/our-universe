# Environment Config
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:8081

# Database Connection (Default Local MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/our_universe

# Cryptographically Secure JWT Tokens
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# Email Transporter (SMTP / Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Spotify Web API Credentials
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/api/auth/spotify/callback

# LocationIQ API Credentials
LOCATIONIQ_ACCESS_TOKEN=your_locationiq_access_token
